# Base URL for issue and codenameh PDFs.
# Issues:   $NEXT_PUBLIC_PDF_BASE_URL/mags/<issue>.pdf
# Codenameh: $NEXT_PUBLIC_PDF_BASE_URL/codenameh/<id>.pdf
NEXT_PUBLIC_PDF_BASE_URL=https://byte-mag.s3.ir-thr-at1.arvanstorage.ir

# Legacy Docusaurus repo, used only by `pnpm migrate` and `pnpm verify:urls`.
BYTE_LEGACY_PATH=../byte-site

# Base URL for ByteCast audio (no trailing slash). Defaults to https://s3.byte-mag.ir/podcast.
# Episode audio: $NEXT_PUBLIC_PODCAST_BASE_URL/<file>
NEXT_PUBLIC_PODCAST_BASE_URL=
